# 仅发布明确列出的源码；运行中的安装与用户数据留在本地。
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/LICENSE-SCOPE.md
!/THIRD_PARTY_NOTICES.md
!/ABOUT.md
!/PROJECT.md
!/插件/
/插件/*
!/插件/ABOUT.md
!/插件/dsh-bili-scroll/
!/resources/
/resources/*
!/resources/app/
/resources/app/*
!/resources/app/lib/
/resources/app/lib/*
!/resources/app/lib/main.js
!/resources/app/lib/desktop-cli.js
!/resources/app/lib/electron-runtime-Be7e-XQ5.js
!/resources/app/lib/native-ui/
/resources/app/lib/native-ui/*
!/resources/app/lib/native-ui/assets/
/resources/app/lib/native-ui/assets/*
!/resources/app/lib/native-ui/assets/compatibility-chrome-Bw7hoNWH.js
**/node_modules/
**/.venv/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
**/*credential*
**/config.json
**/pets.json
**/cycle-memory.json
**/video-cache.json
**/qrcode*
**/*.log
**/*.tmp
**/.DS_Store
